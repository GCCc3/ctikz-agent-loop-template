{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-result.schema.json",
  "title": "Validation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "renderingStatus",
    "sourceArtifact",
    "renderedArtifacts",
    "checks",
    "failureSummary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "renderingStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not-run"
      ]
    },
    "sourceArtifact": {
      "type": "string"
    },
    "renderedArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "message"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "failureSummary": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
