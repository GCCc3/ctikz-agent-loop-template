{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PNG diagram measurement baseline",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "image",
    "parameters",
    "mask",
    "bounds",
    "regions",
    "baseline_sha256",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "tool_version": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "required": ["path", "sha256", "width_px", "height_px"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "parameters": {
      "type": "object",
      "required": ["background", "mask_method", "threshold", "sensitivity_thresholds", "region_units"],
      "properties": {
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "mask_method": { "const": "luminance", "type": "string" },
        "threshold": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "sensitivity_thresholds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
        },
        "region_units": { "type": "string" }
      },
      "additionalProperties": true
    },
    "mask": {
      "type": "object",
      "required": ["ink_pixel_count", "ink_fraction", "ink_bbox_px", "bbox_sensitivity"],
      "properties": {
        "ink_pixel_count": { "type": "integer", "minimum": 0 },
        "ink_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "ink_bbox_px": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "integer", "minimum": 0 }
            }
          ]
        },
        "bbox_sensitivity": { "type": "object" }
      },
      "additionalProperties": true
    },
    "bounds": {
      "type": "object",
      "additionalProperties": true
    },
    "regions": {
      "type": "object",
      "additionalProperties": true
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
